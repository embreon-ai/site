# Waitlist storage (Supabase). Set these in Vercel → Project → Settings → Environment Variables.
# The service role key stays on the server: it is only read by app/api/waitlist/route.ts.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-secret-key   # "secret" key (sb_secret_...) or legacy service_role key
